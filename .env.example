RETRIEVAL_MAX_FILES=200
AUTH_REQUIRED=false
# Map SHA-256 token hashes to roles. Example: {"<sha256>":["reader","reviewer","operator"]}
API_KEY_ROLES={}
OTEL_EXPORTER_OTLP_ENDPOINT=
