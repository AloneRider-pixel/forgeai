GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
RISK_GATE_THRESHOLD=60
HTTP_TIMEOUT_SECONDS=15
DATABASE_URL=sqlite+aiosqlite:///./forgeai.db
AUTO_CREATE_SCHEMA=true
REDIS_URL=
ALLOWED_GITHUB_WORKFLOWS=["ci.yml"]
WEBHOOK_DISPATCH_INTERVAL_SECONDS=2
WEBHOOK_DISPATCH_MAX_ATTEMPTS=5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
